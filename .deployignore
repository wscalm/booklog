# 本番に置かないもの（rsync の --exclude-from 形式。先頭の / はリポジトリ直下の意味）
# ページが使うのは index.html・favicon.*・apple-touch-icon.png・assets/・data/books.js・data/timeline.js・bookimg/ だけ

# データを作るためのスクリプトと元データ
/.gitignore
/*.py
/*.csv
/TLdata.txt
/data/enrich.json
/googlebooks/
/openbd/
__pycache__/

# APIキー（誤ってコミットしても公開しないように）
/.apikey/
